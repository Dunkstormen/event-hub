{
  "name": "@event-hub/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @event-hub/config --filter @event-hub/contracts build",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@event-hub/config": "workspace:*",
    "@event-hub/contracts": "workspace:*",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@event-hub/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
