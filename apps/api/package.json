{
  "name": "@event-hub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @event-hub/config --filter @event-hub/contracts build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "pnpm --filter @event-hub/config --filter @event-hub/contracts build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@event-hub/config": "workspace:*",
    "@event-hub/contracts": "workspace:*",
    "@fastify/type-provider-typebox": "5.2.0",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@event-hub/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
