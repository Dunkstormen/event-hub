# Runtime
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Sessions
SESSION_TTL_SECONDS=28800

# Authorization bootstrap
# Optional CID used by `pnpm db:seed` to provision the first administrator.
BOOTSTRAP_ADMIN_CID=

# MySQL
DATABASE_URL=mysql://event_hub:event_hub@127.0.0.1:3306/event_hub
SHADOW_DATABASE_URL=mysql://event_hub:event_hub@127.0.0.1:3306/event_hub_shadow
TEST_DATABASE_URL=mysql://event_hub_test:event_hub_test@127.0.0.1:3307/event_hub_test

# Local file storage
UPLOAD_ROOT=./var/uploads

# VATSIM Connect sandbox
VATSIM_CONNECT_BASE_URL=https://auth-dev.vatsim.net
VATSIM_CONNECT_CLIENT_ID=
VATSIM_CONNECT_CLIENT_SECRET=
VATSIM_CONNECT_REDIRECT_URI=http://localhost:4000/v1/auth/vatsim/callback
VATSIM_CONNECT_SUCCESS_REDIRECT_URI=http://localhost:3000

# Controller eligibility providers (disabled while API keys are empty)
CONTROL_CENTER_API_BASE_URL=
CONTROL_CENTER_API_KEY=
VATEUD_API_BASE_URL=https://core.vateud.net/api
VATEUD_API_KEY=
CONTROLLER_ELIGIBILITY_SYNC_INTERVAL_SECONDS=3600
CONTROLLER_ELIGIBILITY_FRESHNESS_SECONDS=7200
