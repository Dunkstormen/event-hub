generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleScope {
  GLOBAL
  FIR
}

enum CapabilityScope {
  GLOBAL_ONLY
  GLOBAL_OR_FIR
}

enum FirMembershipSource {
  AUTOMATIC
  MANUAL
}

enum FirMembershipStatus {
  ACTIVE
  REVOKED
}

enum EligibilityProvider {
  CONTROL_CENTER
  VATEUD
}

enum EligibilityProviderStatus {
  SUCCEEDED
  FAILED
}

enum EligibilitySyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum EligibilitySyncTrigger {
  STARTUP
  PERIODIC
  ON_DEMAND
}

enum ControllerEndorsementKind {
  EXAMINER
  FACILITY
  SOLO
  TIER_1
  TIER_2
  VISITING
}

model Vacc {
  id        String   @id @db.VarChar(64)
  name      String   @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  firs      Fir[]

  @@map("vaccs")
}

model Fir {
  id              String               @id @default(cuid()) @db.VarChar(30)
  icaoCode        String               @unique @map("icao_code") @db.Char(4)
  name            String               @db.VarChar(191)
  active          Boolean              @default(true)
  vaccId          String               @map("vacc_id") @db.VarChar(64)
  vacc            Vacc                 @relation(fields: [vaccId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  airports        Airport[]
  roleAssignments UserRoleAssignment[]
  memberships     FirMembership[]
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([vaccId, active])
  @@map("firs")
}

model Airport {
  id        String   @id @default(cuid()) @db.VarChar(30)
  icaoCode  String   @unique @map("icao_code") @db.Char(4)
  name      String   @db.VarChar(191)
  active    Boolean  @default(true)
  firId     String   @map("fir_id") @db.VarChar(30)
  fir       Fir      @relation(fields: [firId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([firId, active])
  @@map("airports")
}

model User {
  id                        String                     @id @default(cuid()) @db.VarChar(30)
  cid                       String                     @unique @db.VarChar(16)
  status                    UserStatus                 @default(ACTIVE)
  lastAuthenticatedAt       DateTime?                  @map("last_authenticated_at") @db.DateTime(3)
  identities                ExternalIdentity[]
  sessions                  Session[]
  roleAssignments           UserRoleAssignment[]
  firMemberships            FirMembership[]            @relation("FirMembershipUser")
  firMembershipChanges      FirMembership[]            @relation("FirMembershipChangedBy")
  eligibilitySnapshots      ControllerEligibilitySnapshot[]
  controllerEndorsements    ControllerEndorsement[]
  authorizationAuditRecords AuthorizationAuditRecord[]
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status])
  @@map("users")
}

model Capability {
  key         String           @id @db.VarChar(96)
  name        String           @db.VarChar(191)
  description String           @db.VarChar(500)
  scope       CapabilityScope
  roles       RoleCapability[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("capabilities")
}

model Role {
  id           String               @id @default(cuid()) @db.VarChar(30)
  key          String               @unique @db.VarChar(64)
  name         String               @db.VarChar(191)
  description  String               @db.VarChar(500)
  scope        RoleScope
  protected    Boolean              @default(false)
  capabilities RoleCapability[]
  assignments  UserRoleAssignment[]
  createdAt    DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([scope])
  @@map("roles")
}

model RoleCapability {
  roleId        String     @map("role_id") @db.VarChar(30)
  capabilityKey String     @map("capability_key") @db.VarChar(96)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  capability    Capability @relation(fields: [capabilityKey], references: [key], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  @@id([roleId, capabilityKey])
  @@index([capabilityKey])
  @@map("role_capabilities")
}

model UserRoleAssignment {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  roleId    String   @map("role_id") @db.VarChar(30)
  firId     String?  @map("fir_id") @db.VarChar(30)
  scopeKey  String   @map("scope_key") @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fir       Fir?     @relation(fields: [firId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([userId, roleId, scopeKey])
  @@index([roleId, scopeKey])
  @@index([firId, userId])
  @@map("user_role_assignments")
}

model FirMembership {
  id                 String                @id @default(cuid()) @db.VarChar(30)
  userId             String                @map("user_id") @db.VarChar(30)
  firId              String                @map("fir_id") @db.VarChar(30)
  source             FirMembershipSource
  status             FirMembershipStatus
  sourceProvider     String?               @map("source_provider") @db.VarChar(64)
  providerFreshUntil DateTime?             @map("provider_fresh_until") @db.DateTime(3)
  reason             String?               @db.VarChar(500)
  changedByUserId    String?               @map("changed_by_user_id") @db.VarChar(30)
  activeSince        DateTime              @default(now()) @map("active_since") @db.DateTime(3)
  revokedAt          DateTime?             @map("revoked_at") @db.DateTime(3)
  user               User                  @relation("FirMembershipUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fir                Fir                   @relation(fields: [firId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedBy          User?                 @relation("FirMembershipChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt          DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([userId, firId])
  @@index([firId, status])
  @@index([userId, status])
  @@index([source, status])
  @@index([changedByUserId, updatedAt], map: "fir_memberships_actor_updated_idx")
  @@map("fir_memberships")
}

model EligibilityProviderState {
  provider            EligibilityProvider       @id
  status              EligibilityProviderStatus
  lastAttemptedAt     DateTime                  @map("last_attempted_at") @db.DateTime(3)
  lastSucceededAt     DateTime?                 @map("last_succeeded_at") @db.DateTime(3)
  freshUntil          DateTime?                 @map("fresh_until") @db.DateTime(3)
  lastErrorCode       String?                   @map("last_error_code") @db.VarChar(64)
  lastErrorMessage    String?                   @map("last_error_message") @db.VarChar(500)
  consecutiveFailures Int                       @default(0) @map("consecutive_failures")
  recordsSeen         Int                       @default(0) @map("records_seen")
  nextRetryAt         DateTime?                 @map("next_retry_at") @db.DateTime(3)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, nextRetryAt])
  @@map("eligibility_provider_states")
}

model EligibilitySyncRun {
  id                 String                   @id @default(cuid()) @db.VarChar(30)
  provider           EligibilityProvider
  trigger            EligibilitySyncTrigger
  status             EligibilitySyncRunStatus
  startedAt          DateTime                 @map("started_at") @db.DateTime(3)
  completedAt        DateTime?                @map("completed_at") @db.DateTime(3)
  fetchedAt          DateTime?                @map("fetched_at") @db.DateTime(3)
  freshUntil         DateTime?                @map("fresh_until") @db.DateTime(3)
  controllersSeen    Int                      @default(0) @map("controllers_seen")
  membershipsChanged Int                     @default(0) @map("memberships_changed")
  errorCode          String?                  @map("error_code") @db.VarChar(64)
  errorMessage       String?                  @map("error_message") @db.VarChar(500)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([provider, startedAt])
  @@index([status, startedAt])
  @@map("eligibility_sync_runs")
}

model ControllerEligibilitySnapshot {
  id          String              @id @default(cuid()) @db.VarChar(30)
  userId      String              @map("user_id") @db.VarChar(30)
  provider    EligibilityProvider
  rostered    Boolean
  ratingCode  String?             @map("rating_code") @db.VarChar(16)
  ratingValue Int?                @map("rating_value")
  fetchedAt   DateTime            @map("fetched_at") @db.DateTime(3)
  freshUntil  DateTime            @map("fresh_until") @db.DateTime(3)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([userId, provider])
  @@index([provider, freshUntil])
  @@index([userId, freshUntil])
  @@map("controller_eligibility_snapshots")
}

model ControllerEndorsement {
  id         String                    @id @default(cuid()) @db.VarChar(30)
  userId     String                    @map("user_id") @db.VarChar(30)
  provider   EligibilityProvider
  sourceKey  String                    @map("source_key") @db.VarChar(191)
  kind       ControllerEndorsementKind
  position   String?                   @db.VarChar(32)
  rating     String?                   @db.VarChar(32)
  validFrom  DateTime?                 @map("valid_from") @db.DateTime(3)
  validUntil DateTime?                 @map("valid_until") @db.DateTime(3)
  fetchedAt  DateTime                  @map("fetched_at") @db.DateTime(3)
  freshUntil DateTime                  @map("fresh_until") @db.DateTime(3)
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([userId, provider, sourceKey])
  @@index([userId, kind, freshUntil])
  @@index([provider, freshUntil])
  @@map("controller_endorsements")
}

model KnownControllerPosition {
  id         String              @id @default(cuid()) @db.VarChar(30)
  provider   EligibilityProvider
  callsign   String              @db.VarChar(32)
  name       String              @db.VarChar(191)
  frequency  String?             @db.VarChar(16)
  fetchedAt  DateTime            @map("fetched_at") @db.DateTime(3)
  freshUntil DateTime            @map("fresh_until") @db.DateTime(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([provider, callsign])
  @@index([callsign, freshUntil])
  @@index([provider, freshUntil])
  @@map("known_controller_positions")
}

model AuthorizationAuditRecord {
  id          String   @id @default(cuid()) @db.VarChar(30)
  actorUserId String   @map("actor_user_id") @db.VarChar(30)
  action      String   @db.VarChar(64)
  targetKind  String   @map("target_kind") @db.VarChar(32)
  targetKey   String   @map("target_key") @db.VarChar(191)
  summary     String   @db.VarChar(500)
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([createdAt])
  @@index([actorUserId, createdAt], map: "authorization_audit_actor_created_idx")
  @@index([targetKind, targetKey, createdAt], map: "authorization_audit_target_created_idx")
  @@map("authorization_audit_records")
}

model ExternalIdentity {
  id           String   @id @default(cuid()) @db.VarChar(30)
  provider     String   @db.VarChar(32)
  subject      String   @db.VarChar(191)
  displayName  String   @map("display_name") @db.VarChar(191)
  givenName    String?  @map("given_name") @db.VarChar(191)
  familyName   String?  @map("family_name") @db.VarChar(191)
  email        String?  @db.VarChar(320)
  lastSyncedAt DateTime @map("last_synced_at") @db.DateTime(3)
  userId       String   @map("user_id") @db.VarChar(30)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("external_identities")
}

model Session {
  id        String    @id @default(cuid()) @db.VarChar(30)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  userId    String    @map("user_id") @db.VarChar(30)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}
