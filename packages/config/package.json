{
  "name": "@event-hub/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    "./project": {
      "types": "./src/project.ts",
      "default": "./dist/project.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@event-hub/typescript-config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
