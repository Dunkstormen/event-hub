{
  "name": "event-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Event management for VATSIM Scandinavia",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @event-hub/database db:generate",
    "db:migrate:deploy": "pnpm --filter @event-hub/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @event-hub/database db:migrate:dev",
    "db:seed": "pnpm --filter @event-hub/database db:seed",
    "db:test:migrate": "pnpm --filter @event-hub/database db:test:migrate",
    "db:test:reset": "pnpm --filter @event-hub/database db:test:reset",
    "db:up": "docker compose up -d --wait",
    "dev:api": "pnpm --filter @event-hub/api dev",
    "dev:web": "pnpm --filter @event-hub/web dev",
    "format:check": "node scripts/check-formatting.mjs",
    "lint": "eslint .",
    "postinstall": "pnpm --filter @event-hub/database db:generate",
    "storage:prepare": "node scripts/prepare-local-storage.mjs",
    "test": "pnpm --recursive --if-present run test",
    "test:integration": "pnpm --filter @event-hub/api test:integration",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
